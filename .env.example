API_HOST=127.0.0.1
API_PORT=3001
WORKSPACE_DB_PATH=./data/workspace.db
WORKSPACE_BACKUP_DIR=./data/backups
WEB_ORIGIN=http://127.0.0.1:5173
LEGACY_JSON_PATH=./data/workspace.json
LOG_LEVEL=info
# Optional server hardening knobs. WEB_ORIGIN accepts comma-separated origins.
API_BODY_LIMIT_BYTES=26214400
API_REQUEST_TIMEOUT_MS=30000
# Optional frontend-only setting for a separately hosted API. Leave empty for
# same-origin Vite/Nginx proxy mode.
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_DEV_TARGET=http://127.0.0.1:3001
# VITE_ZOTERO_DEV_TARGET=http://127.0.0.1:8788
